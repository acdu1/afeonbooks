{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afeonbooks",
  "main": "worker.js",
  "compatibility_date": "2026-08-22",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./artifacts/site/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "afeonbooks.com/*",
      "zone_name": "afeonbooks.com"
    },
    {
      "pattern": "authn.afeonbooks.com",
      "custom_domain": true
    }
  ]
}
